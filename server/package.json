{
  "name": "@vibefinance/server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && node --input-type=module -e \"import fs from 'node:fs'; fs.mkdirSync('dist/db',{recursive:true}); fs.copyFileSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx src/scripts/seed.ts",
    "test": "vitest run",
    "snapshot:build": "tsx src/scripts/snapshot.ts",
    "backtest": "npm run build && node dist/scripts/backtest.js",
    "latency-report": "npm run build && node dist/scripts/latencyReport.js",
    "export-demo": "tsx src/scripts/exportDemo.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@vibefinance/shared": "*",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "fast-xml-parser": "^5.2.5",
    "helmet": "^8.1.0",
    "openai": "^4.104.0",
    "p-limit": "^6.2.0",
    "pino": "^9.9.0",
    "seedrandom": "^3.0.5",
    "yahoo-finance2": "^2.13.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/seedrandom": "^3.0.8",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.4"
  }
}
