PORT=8080
HOST=127.0.0.1
SEED=42
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBED_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBEDDINGS=local
AGENT_TIMEOUT_MS=8000
ANALYSIS_MAX_ACTIVE=3
ANALYSIS_MAX_QUEUED=12
ANALYSIS_QUEUE_TIMEOUT_MS=10000
ANALYSIS_REQUEST_TIMEOUT_MS=45000
ANALYSIS_CACHE_TTL_MS=300000
ANALYSIS_CACHE_MAX_ENTRIES=64
SOURCE_MAX_ACTIVE=6
SOURCE_MAX_QUEUED=24
SOURCE_FAILURE_THRESHOLD=3
SOURCE_COOLDOWN_MS=30000
CORS_ORIGINS=https://erickwarui28.github.io,http://localhost:5173
DB_PATH=./data/vibefinance.db
DATA_MODE=synthetic
# The site switch defaults to live. Demo forces this seeded series and skips the model.
SNAPSHOT_ID=
LIVE_HISTORY_MONTHS=12
FII_CSV_PATH=./data/live/fii_dii.csv
GDELT_ENABLED=true
FEATURES=
OPENAI_VISITOR_HOURLY_LIMIT=100
OPENAI_GLOBAL_LIMIT=10000
OPENAI_NETWORK_HOURLY_LIMIT=300
OPENAI_BUDGET_USD=5
# Update matching prices before changing OPENAI_MODEL; unknown models fail closed.
# Standard short-context prices in USD per million tokens, verified 2026-10-14.
OPENAI_PRICE_MODEL=gpt-6-luna
OPENAI_INPUT_USD_PER_MILLION=0.10
OPENAI_CACHED_USD_PER_MILLION=0.01
OPENAI_CACHE_WRITE_USD_PER_MILLION=0.125
OPENAI_OUTPUT_USD_PER_MILLION=0.50
# Required to enable the VPS activity and quota dashboard at /admin.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Profile Pages frontend build variables (set in the build environment, not this file):
# VITE_BASE=/vibefinance/
# VITE_API_BASE_URL=https://67.211.211.236
